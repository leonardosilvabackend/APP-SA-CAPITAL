{
  "name": "sa-capital-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --import tsx scripts/run.mjs development dev",
    "build": "npm run check && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx scripts/run.mjs test test",
    "db:generate": "node --import tsx scripts/run.mjs development generate",
    "db:migrate": "npm run db:migrate:dev",
    "db:studio": "node --import tsx scripts/run.mjs development studio",
    "db:import-administrators": "node --import tsx scripts/run.mjs development import",
    "db:migrate:dev": "node --import tsx scripts/run.mjs development migrate",
    "db:migrate:test": "node --import tsx scripts/run.mjs test migrate",
    "db:migrate:prod": "node --import tsx scripts/run.mjs production migrate",
    "dev:test": "node --import tsx scripts/run.mjs test dev",
    "db:seed:test": "node --import tsx scripts/run.mjs test seed",
    "db:test:start": "node scripts/test-database.mjs start",
    "db:test:stop": "node scripts/test-database.mjs stop",
    "verify": "npm run test -- --no-cache && npm run build",
    "db:bootstrap:test": "node --import tsx scripts/run.mjs test bootstrap",
    "db:bootstrap:dev": "node --import tsx scripts/run.mjs development bootstrap",
    "test:e2e": "node --import tsx scripts/e2e-test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.90.2",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.44.5",
    "express": "^4.21.2",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "postgres": "^3.4.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.64.0",
    "sonner": "^2.0.7",
    "wouter": "^3.7.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.10",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.4.1"
}
