# Aplicação
PORT=3000
APP_URL=http://localhost:3000
JWT_SECRET=gere-uma-chave-longa-e-exclusiva

# PostgreSQL/Supabase (use a conexão com pool para a aplicação)
DATABASE_URL=postgresql://usuario:senha@host:6543/postgres

# Supabase Storage (somente no servidor)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=substitua-localmente
SUPABASE_STORAGE_BUCKET=documents

# E-mail transacional
RESEND_API_KEY=substitua-localmente
RESEND_FROM_EMAIL=SA Capital <contato@seudominio.com.br>
