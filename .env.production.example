# Referência: configure no Railway. .env.production não ? carregado.
APP_ENV=production
NODE_ENV=production
DATABASE_ENV=production
DATABASE_URL=
JWT_SECRET=
APP_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_ENABLED=true
ENABLE_SCHEDULED_JOBS=true
FB_SYNC_ENABLED=false
# Apenas para a etapa explícita de migrations no deploy:
CONFIRM_PRODUCTION_MIGRATIONS=apply-production-migrations
# RAILWAY_ENVIRONMENT_ID, RAILWAY_SERVICE_ID e RAILWAY_DEPLOYMENT_ID vêm da infraestrutura.

# Numero de proxies confiaveis; use 0 localmente e confira a topologia em producao.
TRUST_PROXY_HOPS=0
