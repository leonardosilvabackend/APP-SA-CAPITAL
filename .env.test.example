# Copie para .env.test. Nunca use credenciais de produção.
APP_ENV=test
NODE_ENV=test
DATABASE_ENV=test
# Formato: postgresql://sa_test:SENHA_LOCAL@127.0.0.1:5434/sa_capital_test
DATABASE_URL=
JWT_SECRET=
APP_URL=http://localhost:3000
PORT=3000
EMAIL_ENABLED=false
ENABLE_SCHEDULED_JOBS=false
FB_SYNC_ENABLED=false
# Storage bloqueado fora de produção.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Automatic FB synchronization (TEST only)
FB_SYNC_SCHEDULE_ENABLED=false
FB_SYNC_INTERVAL_MINUTES=30

# Numero de proxies confiaveis; use 0 localmente e confira a topologia em producao.
TRUST_PROXY_HOPS=0
